{
  "expo": {
    "name": "Gerenciador de Eventos",
    "slug": "gerenciador-eventos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.desafio.eventos" },
    "android": { "package": "com.desafio.eventos" },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Permita o acesso às suas fotos para escolher a imagem do evento." }]
    ]
  }
}
